# Public site URL (no trailing slash). Used to build PayHere return/cancel/notify URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — Admin → Data Streams → your stream → Measurement ID.
# Leave empty to disable analytics (e.g. in local dev).
NEXT_PUBLIC_GA_ID=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# PayHere — Merchant Dashboard → Integrations
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# "sandbox" (default) or "live"
PAYHERE_MODE=sandbox
