# Public site URL (no trailing slash). Used to build PayHere return/cancel/notify URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager — tagmanager.google.com, container ID (starts with "GTM-").
# The GA4 tag itself must still be configured and published inside that
# container (Tags -> New -> Google Analytics: GA4 Configuration) or no data
# is sent. Leave empty to disable (e.g. in local dev).
NEXT_PUBLIC_GTM_ID=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# PayHere — Merchant Dashboard → Integrations
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# "sandbox" (default) or "live"
PAYHERE_MODE=sandbox
